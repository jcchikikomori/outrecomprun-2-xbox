# Build output (out/build/cross-windows is the Windows cross-build)
/out/
/build/

# Windows cross-build: xwin downloads its tool, cache and the Windows SDK/UCRT sysroot here
/.local/xwin/
/.xwin/

# Recompiled code derived from the game: never commit or redistribute
/generated/

# Generated XDK symbol analysis; regenerated by xbe_symbols
/config/game.toml

# User-supplied game media: disc image, default.xbe, extracted folders
/assets/

# Local analysis, run folders, logs and frame captures (game imagery)
/.local/
/captures/
/logs/
/hdd/
/CrashDumps/

# Files the runtime writes beside the executable
settings.toml
achievements.toml
# Proton/DXVK shader caches written beside a working directory
vkd3d-proton.cache*
dxvk-cache

# Archive and compiler output
*.zip
*.pdb
*.exe
*.obj
*.o
*.dll

# Game media left outside assets/ by accident
*.iso
*.xbe
*.cvm
*.CVM
*.SFD
*.sfd

# Editors and Python tooling
.vs/
.vscode/
.idea/
.venv/
__pycache__/
*.pyc
